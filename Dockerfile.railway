# syntax=docker/dockerfile:1.7
FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        bash \
        ca-certificates \
        coreutils \
        python3 \
        tini \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --chmod=0555 railway-frozen/engine /app/bin/engine
COPY --chmod=0444 railway-frozen/engine.sha256 /app/bin/engine.sha256
COPY --chmod=0555 scripts/run_su6_railway.sh /app/bin/run_su6_railway.sh
COPY --chmod=0555 scripts/hl_bot.py /app/bin/hl_bot.py
COPY --chmod=0444 railway-frozen/copytrade.json /app/config/copytrade.json
COPY --chmod=0444 railway-frozen/very-profitable-layer.json /app/config/very-profitable-layer.json
COPY --chmod=0444 railway-frozen/read-api-policy.json /app/policy/read-api-policy.json
COPY --chmod=0444 railway-frozen/public-mainnet-transport.json /app/policy/public-mainnet-transport.json
COPY --chmod=0444 THIRD_PARTY_NOTICES.md /app/THIRD_PARTY_NOTICES.md

# Verify the embedded frozen artifact before any container can start trading.
RUN sha256sum --check /app/bin/engine.sha256 \
    && sha256sum /app/bin/engine \
    && /app/bin/engine \
        --config /app/config/copytrade.json \
        --very-profitable-layer /app/config/very-profitable-layer.json \
        --print-persistence-schema-hash \
        >/dev/null

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python3", "/app/bin/hl_bot.py", "supervise"]
